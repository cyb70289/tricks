{
  "enabled": true,
  "permissionPromptTimeoutSeconds": 0,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": ["*"],
    "deniedDomains": [""]
  },
  "filesystem": {
    "denyRead": [],
    "allowRead": ["*"],
    "allowWrite": [".", "/tmp", "~/.npm", "~/.cache", "~/.local", "~/.pi"],
    "denyWrite": []
  }
}
